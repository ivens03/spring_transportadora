# Copie para .env e preencha:  cp .env.example .env
# Gerar segredos:  openssl rand -base64 48   (JWT)   |   openssl rand -base64 32   (pepper)

# --- Aplicacao ---
SERVER_PORT=8085

# --- Banco (Postgres do compose.yaml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=rotacerta
POSTGRES_USER=rotacerta
POSTGRES_PASSWORD=troque-aqui

# --- JWT: segredo HMAC-SHA256 (>= 32 bytes) ---
ROTACERTA_JWT_SEGREDO=troque-aqui-por-um-segredo-com-pelo-menos-32-bytes

# --- Pepper do Argon2id: segredo global que NUNCA vai para o banco (base64, >= 32 bytes) ---
ROTACERTA_PEPPER=troque-aqui

# --- Primeiro ADMINISTRATIVO ---
ROTACERTA_ADMIN_EMAIL=admin@rotacerta.local
ROTACERTA_ADMIN_SENHA=troque-aqui-10-caracteres-com-letras-e-numeros
